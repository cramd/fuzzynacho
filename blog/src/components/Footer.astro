---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => data.published !== false);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 5); // Limit to top 5 in footer to prevent bloating
---
<footer class="bg-slate-50 dark:bg-zinc-950 border-t border-slate-200 dark:border-zinc-800 py-12 transition-colors duration-200 mt-20">
    <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="space-y-3">
            <span class="text-lg font-black tracking-wider text-indigo-600 dark:text-indigo-400 font-mono">FUZZYNACHO</span>
            <p class="text-xs text-slate-500 dark:text-zinc-400 leading-relaxed">
                A raw look at historical cycles, systemic governance models, and engineering strategies. No fluff, just the critical details.
            </p>
        </div>
        <div>
            <h4 class="font-bold text-slate-800 dark:text-zinc-200 text-sm uppercase mb-3">Essays</h4>
            <ul class="space-y-2 text-xs text-slate-600 dark:text-zinc-400">
                {posts.map((post) => (
                    <li>
                        <a href={`/blog/${post.id}`} class="hover:text-indigo-600 dark:hover:text-indigo-400 flex items-start gap-1.5 group">
                            <span class="mt-0.5 shrink-0 text-indigo-500/60 group-hover:text-indigo-500">›</span>
                            <span class="leading-snug">{post.data.title}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
        <div>
            <h4 class="font-bold text-slate-800 dark:text-zinc-200 text-sm uppercase mb-3">Newsletter</h4>
            <p class="text-xs text-slate-500 dark:text-zinc-400 mb-3">Get notifications when a new long-form essay drops.</p>
            <form onsubmit="event.preventDefault(); alert('Subscribed to FuzzyNacho perspectives! (Simulated)');" class="flex space-x-2">
                <input type="email" placeholder="you@example.com" required class="px-3 py-2 text-xs rounded bg-white dark:bg-zinc-800 border border-slate-300 dark:border-zinc-700 focus:outline-none focus:ring-1 focus:ring-indigo-500 w-full text-slate-800 dark:text-zinc-100">
                <button type="submit" class="px-4 py-2 bg-indigo-600 text-white text-xs font-bold rounded hover:bg-indigo-500 transition cursor-pointer">Join</button>
            </form>
        </div>
    </div>
    <div class="max-w-6xl mx-auto px-4 mt-8 pt-8 border-t border-slate-200 dark:border-zinc-800 text-center text-[10px] text-slate-400">
        &copy; 2026 fuzzynacho.org. All rights reserved. Built with precision for premium clarity.
    </div>
</footer>
