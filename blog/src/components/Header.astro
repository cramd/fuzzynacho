---
---
<header class="border-b border-stone-200/60 dark:border-zinc-800 bg-white/80 dark:bg-zinc-900/80 backdrop-blur sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/blog" class="flex items-center space-x-3 group">
            <!-- FuzzyNacho Cool Logo (Nacho chip with sunglasses) -->
            <svg class="w-10 h-10 transform group-hover:scale-110 transition-transform duration-200 cursor-pointer" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <polygon points="50,15 15,80 85,80" fill="#f59e0b" stroke="#b45309" stroke-width="4" stroke-linejoin="round"/>
                <!-- Cheese spots -->
                <circle cx="45" cy="55" r="4" fill="#d97706" />
                <circle cx="58" cy="70" r="3" fill="#d97706" />
                <circle cx="35" cy="72" r="5" fill="#d97706" />
                <!-- Sunglasses -->
                <rect x="35" y="42" width="14" height="8" rx="2" fill="#1c1917" />
                <rect x="51" y="42" width="14" height="8" rx="2" fill="#1c1917" />
                <path d="M49 44 L51 44" stroke="#1c1917" stroke-width="2" />
                <path d="M30 44 L35 44" stroke="#1c1917" stroke-width="2" />
                <path d="M65 44 L60 44" stroke="#1c1917" stroke-width="2" />
                <!-- Smug Smile -->
                <path d="M45 64 Q50 68 55 64" stroke="#78350f" stroke-width="3" stroke-linecap="round" fill="none" />
            </svg>
            <div>
                <span class="text-xl font-extrabold tracking-tight text-indigo-600 dark:text-indigo-400 font-mono">FUZZYNACHO</span>
                <span class="block text-[10px] tracking-widest text-slate-500 uppercase font-bold">Unfiltered Perspectives</span>
            </div>
        </a>
        
        <div class="flex items-center space-x-4">
            <nav class="hidden md:flex space-x-6 text-sm font-semibold text-slate-600 dark:text-zinc-300">
                <a href="/blog" class="hover:text-indigo-600 dark:hover:text-indigo-400">Latest Essays</a>
                <a href="https://www.fuzzynacho.org" class="hover:text-indigo-600 dark:hover:text-indigo-400 font-mono text-xs px-2 py-1 rounded bg-slate-100 dark:bg-zinc-800">fuzzynacho.org</a>
            </nav>
            
            <!-- Dark Mode Toggler Button -->
            <button id="themeToggleBtn" class="p-2 rounded-lg bg-slate-100 dark:bg-zinc-800 text-slate-600 dark:text-zinc-300 hover:bg-slate-200 dark:hover:bg-zinc-700 transition" aria-label="Toggle Dark Mode">
                <!-- Sun Icon (visible in dark) -->
                <svg id="sunIcon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464a1 1 0 10-1.414 1.414l.707.707a1 1 0 001.414-1.414l-.707-.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
                <!-- Moon Icon (visible in light) -->
                <svg id="moonIcon" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
            </button>
        </div>
    </div>
</header>
