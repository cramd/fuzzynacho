---
const huntModeUrl = "https://www.huntmode.ca";
---

<div
  class="border-b border-amber-500/30 bg-amber-500/10 px-4 py-3 text-center text-sm text-amber-900 dark:text-amber-100"
  role="status"
>
  <p>
    Looking for the <strong class="font-semibold text-slate-900 dark:text-white">HuntMode app</strong>?
    It has moved to
    <a
      href={huntModeUrl}
      class="font-semibold text-amber-800 underline decoration-amber-500/60 underline-offset-2 transition-colors hover:text-slate-900 dark:text-amber-200 dark:hover:text-white"
    >
      HuntMode.ca
    </a>.
  </p>
</div>
