---
import { getCollection } from 'astro:content';
import DecayCalculator from './DecayCalculator.astro';

const { showCalculator = false } = Astro.props;

const allPosts = await getCollection('blog', ({ data }) => data.published !== false);
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = allPosts.slice(0, 3);
---

<aside class="space-y-8">
    <!-- Author Card -->
    <div class="bg-white dark:bg-zinc-900 p-6 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm">
        <div class="flex items-center space-x-4">
            <div class="w-12 h-12 rounded-full bg-indigo-600 flex items-center justify-center font-extrabold text-white text-base shadow-inner">
                FN
            </div>
            <div>
                <h3 class="font-bold text-slate-900 dark:text-zinc-50 text-base">FuzzyNacho</h3>
                <p class="text-[10px] text-slate-500 dark:text-zinc-400">fuzzynacho.org • Unfiltered Tech & Society</p>
            </div>
        </div>
        <p class="mt-4 text-xs text-slate-600 dark:text-zinc-400 leading-relaxed">
            Analyzing macrotrends, institutional collapse, and tech ecosystems without the corporate sugarcoating. 
        </p>
        <div class="mt-4 pt-4 border-t border-slate-100 dark:border-zinc-800 flex justify-between items-center text-[10px] text-slate-500">
            <span>📍 Richmond, BC, Canada</span>
            <a href="https://www.fuzzynacho.org" class="text-indigo-600 dark:text-indigo-400 hover:underline">Read Bio →</a>
        </div>
    </div>

    <!-- Conditional Decay Calculator -->
    {showCalculator && <DecayCalculator />}

    <!-- Related Posts Widget -->
    <div class="bg-white dark:bg-zinc-900 p-6 rounded-2xl border border-slate-200 dark:border-zinc-800 shadow-sm space-y-4">
        <h3 class="font-bold text-slate-400 dark:text-zinc-500 text-[10px] uppercase tracking-wider">Other Essays</h3>
        <div class="space-y-3">
            {recentPosts.map((post, idx) => (
                <>
                    <a href={`/blog/${post.id}`} class="block group">
                        <span class="text-[9px] text-indigo-600 dark:text-indigo-400 font-bold uppercase tracking-wider">
                            {post.data.tags.length > 0 ? post.data.tags[0] : "Perspective"}
                        </span>
                        <h4 class="font-bold text-slate-800 dark:text-zinc-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition text-xs leading-snug mt-1">
                            {post.data.title}
                        </h4>
                    </a>
                    {idx < recentPosts.length - 1 && <hr class="border-slate-100 dark:border-zinc-800" />}
                </>
            ))}
        </div>
    </div>
</aside>
