---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => data.published !== false);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = posts.find((post) => post.data.featured);
const regularPosts = featuredPost ? posts.filter((post) => post.id !== featuredPost.id) : posts;
---

<Layout frontmatter={{ 
    title: "FuzzyNacho Blog", 
    description: "Thoughts on macrotrends, institutional decay, and tech ecosystems without the corporate sugarcoating." 
}}>
    <div class="not-prose space-y-12">
        
        {featuredPost && (
            <div class="space-y-6">
                <h2 class="text-xs font-bold uppercase tracking-widest text-stone-400 dark:text-zinc-500">Featured Transmission</h2>
                <a href={`/blog/${featuredPost.id}`} class="block group">
                    <article class="grid grid-cols-1 md:grid-cols-12 bg-white dark:bg-zinc-850 rounded-2xl border border-stone-200/60 dark:border-zinc-700/50 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden min-h-[350px]">
                        
                        {/* Featured Image */}
                        <div class="md:col-span-7 h-64 md:h-full overflow-hidden bg-stone-100 dark:bg-zinc-900 border-b md:border-b-0 md:border-r border-stone-200/50 dark:border-zinc-800 relative">
                            {featuredPost.data.coverImage ? (
                                <img 
                                    src={featuredPost.data.coverImage} 
                                    alt={featuredPost.data.coverImageAlt || featuredPost.data.title} 
                                    class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
                                />
                            ) : (
                                <div class="w-full h-full bg-gradient-to-br from-amber-500/10 to-red-500/10 dark:from-amber-500/5 dark:to-red-500/5 flex items-center justify-center relative">
                                    <div class="absolute inset-0 opacity-20 dark:opacity-10 flex" style="background-image: radial-gradient(circle at 2px 2px, currentColor 1.5px, transparent 0); background-size: 20px 20px; color: #d97706;"></div>
                                    <div class="text-amber-600/40 dark:text-amber-500/30 text-5xl font-black font-mono tracking-tighter uppercase select-none">FEATURED</div>
                                </div>
                            )}
                        </div>

                        {/* Featured Text content */}
                        <div class="md:col-span-5 p-8 flex flex-col justify-between">
                            <div>
                                <span class="text-[10px] text-amber-600 dark:text-amber-500 font-bold uppercase tracking-wider mb-2 block">
                                    {featuredPost.data.tags.length > 0 ? featuredPost.data.tags[0] : "Featured"}
                                </span>
                                <h3 class="text-2xl md:text-3xl font-extrabold text-stone-900 dark:text-zinc-50 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors duration-200 leading-tight mb-4">
                                    {featuredPost.data.title}
                                </h3>
                                <p class="text-sm text-stone-600 dark:text-zinc-400 leading-relaxed">
                                    {featuredPost.data.description}
                                </p>
                            </div>
                            
                            <div class="mt-8 pt-4 border-t border-stone-100 dark:border-zinc-800/80 flex items-center justify-between text-xs text-stone-500 dark:text-zinc-500">
                                <time class="font-medium">
                                    {featuredPost.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                                </time>
                                <span class="flex items-center">
                                    <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                                    7 min read
                                </span>
                            </div>
                        </div>
                    </article>
                </a>
            </div>
        )}

        <div class="space-y-6">
            <h2 class="text-xs font-bold uppercase tracking-widest text-stone-400 dark:text-zinc-500">Latest Transmissions</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 auto-rows-fr">
                {regularPosts.map((post) => (
                    <a href={`/blog/${post.id}`} class="block group h-full">
                        <article class="flex flex-col h-full bg-white dark:bg-zinc-850 rounded-2xl border border-stone-200/60 dark:border-zinc-700/50 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
                            
                            {/* Cover Image / Visual Placeholder */}
                            {post.data.coverImage ? (
                                <div class="w-full h-48 overflow-hidden bg-stone-100 dark:bg-zinc-900 border-b border-stone-100 dark:border-zinc-800">
                                    <img 
                                        src={post.data.coverImage} 
                                        alt={post.data.coverImageAlt || post.data.title} 
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                    />
                                </div>
                            ) : (
                                <div class="w-full h-48 bg-gradient-to-br from-amber-500/10 to-red-500/10 dark:from-amber-500/5 dark:to-red-500/5 flex items-center justify-center border-b border-stone-200/50 dark:border-zinc-800 overflow-hidden relative">
                                    <div class="absolute inset-0 opacity-20 dark:opacity-10 flex" style="background-image: radial-gradient(circle at 2px 2px, currentColor 1.5px, transparent 0); background-size: 20px 20px; color: #d97706;"></div>
                                    <div class="text-amber-600/40 dark:text-amber-500/30 text-5xl font-black font-mono tracking-tighter uppercase select-none">PERSPECTIVE</div>
                                </div>
                            )}

                            <div class="p-6 flex flex-col flex-grow">
                                <span class="text-[10px] text-amber-600 dark:text-amber-500 font-bold uppercase tracking-wider mb-2 block">
                                    {post.data.tags.length > 0 ? post.data.tags[0] : "Essays"}
                                </span>
                                <h3 class="text-xl font-bold text-stone-900 dark:text-zinc-50 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors duration-200 line-clamp-2 leading-snug mb-3">
                                    {post.data.title}
                                </h3>
                                <p class="text-sm text-stone-600 dark:text-zinc-400 line-clamp-3 leading-relaxed flex-grow">
                                    {post.data.description}
                                </p>
                                
                                <div class="mt-6 pt-4 border-t border-stone-100 dark:border-zinc-800/80 flex items-center justify-between text-xs text-stone-500 dark:text-zinc-500">
                                    <time class="font-medium">
                                        {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                                    </time>
                                    <span class="flex items-center">
                                        <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                                        7 min read
                                    </span>
                                </div>
                            </div>
                        </article>
                    </a>
                ))}
            </div>
        </div>
    </div>
</Layout>
