---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';

const { frontmatter } = Astro.props;

const isPost = !!frontmatter.pubDate;
const title = frontmatter.title || "FuzzyNacho";
const description = frontmatter.description || "";
const pubDate = frontmatter.pubDate;
const author = frontmatter.author || "FuzzyNacho";
const tags = frontmatter.tags || [];

const seoTitle = frontmatter.seoTitle || title;
const seoDescription = frontmatter.seoDescription || description;
const socialImage = frontmatter.socialImage || frontmatter.coverImage || "/blog/favicon.svg";
const showCalculator = frontmatter.id === 'empiresdementia';
---

<!doctype html>
<html lang="en" class="min-h-screen transition-colors duration-200">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{seoTitle} | FuzzyNacho</title>
		<meta name="description" content={seoDescription} />
		{frontmatter.published === false && (
			<meta name="robots" content="noindex, nofollow" />
		)}

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={isPost ? "article" : "website"} />
		<meta property="og:title" content={seoTitle} />
		<meta property="og:description" content={seoDescription} />
		<meta property="og:image" content={socialImage} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content={seoTitle} />
		<meta property="twitter:description" content={seoDescription} />
		<meta property="twitter:image" content={socialImage} />
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-M7B7K5L6WF"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-M7B7K5L6WF');
		</script>
        
        <!-- Script to toggle light/dark theme immediately before HTML renders (to avoid flash) -->
        <script is:inline>
            if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        </script>
	</head>
	<body class="bg-slate-50 text-slate-800 dark:bg-zinc-950 dark:text-zinc-200 min-h-screen transition-colors duration-200">
        <Header />

        <!-- Main Hero Banner -->
        <div class="bg-gradient-to-b from-slate-100 to-transparent dark:from-zinc-900/30 py-10 border-b border-slate-200/50 dark:border-zinc-900">
            <div class="max-w-4xl mx-auto px-6 md:px-8 lg:px-12 text-center">
                {isPost && (
                    <div class="mb-6 flex justify-center">
                        <a href="/blog" class="inline-flex items-center text-sm font-medium text-slate-500 hover:text-indigo-600 dark:text-zinc-400 dark:hover:text-indigo-400 transition-colors">
                            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                            Back to all posts
                        </a>
                    </div>
                )}
                {isPost && tags.length > 0 && (
                    <span class="px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-indigo-700 bg-indigo-50 dark:text-indigo-400 dark:bg-indigo-950/40 rounded-full">
                        {tags[0]}
                    </span>
                )}
                <h1 class="mt-4 text-2xl md:text-3.5xl font-extrabold tracking-tight leading-tight text-slate-900 dark:text-zinc-50">
                    {title}
                </h1>
                {description && (
                    <p class="mt-3 text-sm md:text-base text-slate-600 dark:text-zinc-400 max-w-2xl mx-auto font-normal leading-relaxed">
                        {description}
                    </p>
                )}
                {isPost && (
                    <div class="mt-5 flex items-center justify-center space-x-3 text-xs text-slate-500 dark:text-zinc-500">
                        <span class="font-semibold text-slate-700 dark:text-zinc-300">By {author}</span>
                        <span>•</span>
                        <span>{new Date(pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</span>
                        <span>•</span>
                        <span class="flex items-center text-indigo-600 dark:text-indigo-400">
                            <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                            </svg>
                            7 min read
                        </span>
                    </div>
                )}
            </div>
        </div>

        <!-- Main Layout Container -->
        <main class="max-w-6xl mx-auto px-6 md:px-8 lg:px-12 py-12 grid grid-cols-1 lg:grid-cols-12 gap-12" id="article">
            <!-- Left Column: The Main Article / Page content (9 cols on lg) -->
            <div class="lg:col-span-9">
                {isPost ? (
                    <article class="prose dark:prose-invert prose-slate max-w-none text-base leading-relaxed text-slate-700 dark:text-zinc-300">
                        {frontmatter.coverImage && (
                            <div class="bg-slate-100 dark:bg-zinc-900/80 rounded-2xl p-6 border border-slate-200 dark:border-zinc-800 shadow-md mb-8 flex justify-center">
                                <img src={frontmatter.coverImage} alt={frontmatter.coverImageAlt || title} class="max-w-full h-auto rounded-xl mx-auto" />
                            </div>
                        )}
                        <slot />
                        <div class="mt-12 pt-8 border-t border-slate-200 dark:border-zinc-800">
                            <a href="/blog" class="inline-flex items-center text-base font-semibold text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300 transition-colors group">
                                <svg class="w-5 h-5 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                                Back to all posts
                            </a>
                        </div>
                    </article>
                    <slot name="after-article" />
                ) : (
                    <slot />
                )}
            </div>
            
            <!-- Right Column: Sidebar (3 cols on lg) -->
            <div class="lg:col-span-3">
                <Sidebar showCalculator={showCalculator} />
            </div>
        </main>

        <Footer />

        <script>
            // Client-side Dark Mode Toggle logic
            const themeToggleBtn = document.getElementById('themeToggleBtn');
            const sunIcon = document.getElementById('sunIcon');
            const moonIcon = document.getElementById('moonIcon');

            function updateIcons() {
                if (!sunIcon || !moonIcon) return;
                if (document.documentElement.classList.contains('dark')) {
                    sunIcon.classList.remove('hidden');
                    moonIcon.classList.add('hidden');
                } else {
                    sunIcon.classList.add('hidden');
                    moonIcon.classList.remove('hidden');
                }
            }

            // Sync icons on load
            updateIcons();

            if (themeToggleBtn) {
                themeToggleBtn.addEventListener('click', () => {
                    let theme = 'light';
                    if (document.documentElement.classList.contains('dark')) {
                        document.documentElement.classList.remove('dark');
                        localStorage.setItem('theme', 'light');
                    } else {
                        document.documentElement.classList.add('dark');
                        localStorage.setItem('theme', 'dark');
                        theme = 'dark';
                    }
                    updateIcons();
                    window.dispatchEvent(new CustomEvent('themechange', { detail: { theme } }));
                });
            }
        </script>
	</body>
</html>
