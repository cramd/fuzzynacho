# Copy to .env and fill in values from https://giscus.app
#
# Prerequisites:
# 1. Public GitHub repo with Discussions enabled
# 2. Configure Giscus at giscus.app (mapping: pathname, reactions: enabled)
#
PUBLIC_GISCUS_REPO=youruser/your-repo
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Blog Comments
PUBLIC_GISCUS_CATEGORY_ID=
